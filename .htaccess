# Eduba web app: static files, served as they are.

# Correct types for fonts, audio and the manifest
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType audio/mpeg .mp3
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddCharset utf-8 .html .css .webmanifest
</IfModule>

# Fonts are cached for a year, audio and photos for 30 days (re-record a clip under the
# same name and returning visitors may hear the old one for up to a month).
# index.html is checked on every visit so updates show up right away.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(mp3|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json image/svg+xml
</IfModule>

# Keep WordPress's permalink rules from touching this folder
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>
Options -Indexes
DirectoryIndex index.html
